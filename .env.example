# Credentials untuk testing
TEST_EMAIL=your-email@gmail.com
TEST_PASSWORD=your-password

# Token untuk bypass login di Playwright MCP (copy dari browser DevTools > Application > Cookies > token)
# Update token ini kalau expired (biasanya 24 jam)
AUTH_TOKEN=your-token

# Groq AI (untuk LLM test) - gratis di console.groq.com
GROQ_API_KEY=your-groq-api-key

# Gmail IMAP untuk ambil OTP
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
